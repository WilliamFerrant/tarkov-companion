{
  "name": "tarkov-price-hover",
  "version": "1.0.1",
  "private": true,
  "description": "Overlay Windows affichant le prix des items d'Escape from Tarkov au survol (OCR + API tarkov.dev). Usage personnel.",
  "main": "dist/main/main.js",
  "author": "personal",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "npm run build && node scripts/start.mjs",
    "dev": "npm run build && node scripts/start.mjs --dev",
    "typecheck": "tsc --noEmit",
    "verify-api": "node scripts/verify-api.mjs",
    "test": "npm run test:match && npm run test:ocr && npm run test:region && npm run test:failures",
    "test:all": "npm run test && npm run test:grid && npm run test:icons",
    "test:match": "npm run build && node dist/tools/match-selftest.js",
    "test:ocr": "npm run build && node scripts/start.mjs --entry dist/tools/ocr-selftest.js",
    "test:failures": "npm run build && node scripts/start.mjs --entry dist/tools/failure-selftest.js",
    "test:region": "npm run build && node scripts/start.mjs --entry dist/tools/region-selftest.js",
    "test:stutter": "npm run build && node scripts/stutter-probe.mjs",
    "test:icons": "npm run build && node scripts/start.mjs --entry dist/tools/icon-selftest.js",
    "test:grid": "npm run build && node scripts/start.mjs --entry dist/tools/grid-selftest.js",
    "icons": "node scripts/make-icons.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "preversion": "node scripts/preversion.mjs",
    "postversion": "node -e \"console.log('\\n  Tag cree. Publiez-le :\\n\\n    git push --follow-tags\\n')\"",
    "release:patch": "npm version patch -m \"Version %s\"",
    "release:minor": "npm version minor -m \"Version %s\"",
    "release:major": "npm version major -m \"Version %s\""
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "local.tarkov.price.hover",
    "productName": "TarkovPriceHover",
    "publish": [
      {
        "provider": "github",
        "owner": "WilliamFerrant",
        "repo": "tarkov-companion",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/native/**",
      "!dist/selftest/**",
      "!dist/tools/**",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/native",
        "to": "native"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tarkov Price Hover"
    }
  }
}
